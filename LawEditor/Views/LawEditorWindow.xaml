<Window x:Class="LawEditor.Views.LawEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LawEditor.Models.ChangableData"
        xmlns:src="clr-namespace:LawEditor.Models.ChangableSourse"
        xmlns:root="clr-namespace:LawEditor.Models.RootClasses"
        Title="Law Editor"
        Height="700" Width="1100"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Writing_laws2.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="200"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: дерево -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TreeView Grid.Row="0" ItemsSource="{Binding TreeRoots}"
                      SelectedItemChanged="TreeView_SelectedItemChanged">
                <TreeView.Resources>

                    <!-- Laws (Header) -->
                    <DataTemplate DataType="{x:Type root:Laws}">
                        <TextBlock Text="{Binding Header}"
                                   FontWeight="Bold"
                                   Foreground="DarkSlateBlue"/>
                    </DataTemplate>

                    <!-- Chapter -->
                    <HierarchicalDataTemplate DataType="{x:Type local:Chapter}"
                                              ItemsSource="{Binding Sections}">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                    </HierarchicalDataTemplate>

                    <!-- Section -->
                    <HierarchicalDataTemplate DataType="{x:Type local:Section}"
                                              ItemsSource="{Binding Articles}">
                        <TextBlock Text="{Binding Title}"/>
                    </HierarchicalDataTemplate>

                    <!-- Article -->
                    <HierarchicalDataTemplate DataType="{x:Type local:Article}"
                                              ItemsSource="{Binding Clauses}">
                        <TextBlock Text="{Binding Title}"/>
                    </HierarchicalDataTemplate>

                    <!-- Clause -->
                    <HierarchicalDataTemplate DataType="{x:Type local:Clause}"
                                              ItemsSource="{Binding SubClauses}">
                        <TextBlock Text="{Binding Text}"/>
                    </HierarchicalDataTemplate>

                    <!-- SubClause -->
                    <DataTemplate DataType="{x:Type local:SubClause}">
                        <TextBlock Text="{Binding Text}"/>
                    </DataTemplate>

                    <!-- SorseData -->
                    <HierarchicalDataTemplate DataType="{x:Type src:SourceData}"
                          ItemsSource="{Binding Source}">
                        <TextBlock Text="{Binding Type}" />
                    </HierarchicalDataTemplate>
                    <!-- TransitionalProvisions -->
                    <DataTemplate DataType="{x:Type src:TransitionalProvisions}">
                        <TextBlock Text="{Binding Title}" Foreground="DarkBlue" FontWeight="Bold"/>
                    </DataTemplate>

                    <!-- SourceDocumentsList -->
                    <DataTemplate DataType="{x:Type src:SourceDocumentsList}">
                        <TextBlock Text="{Binding Title}" Foreground="DarkGreen" FontWeight="Bold"/>
                    </DataTemplate>

                    <!-- ConstitutionalAmendment -->
                    <DataTemplate DataType="{x:Type src:ConstitutionalAmendment}">
                        <TextBlock Text="{Binding Title}" Foreground="DarkRed" FontWeight="Bold"/>
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>

            <!-- Кнопки Add / Delete -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4">
                <ToggleButton Content="Add" Width="80" Margin="2"
                              IsChecked="{Binding IsAddMenuOpen, Mode=TwoWay}"/>

                <Popup IsOpen="{Binding IsAddMenuOpen, Mode=TwoWay}"
                       Placement="Bottom"
                       StaysOpen="False">
                    <Border Background="White" BorderBrush="#AAAAAA" BorderThickness="1" Padding="2">
                        <StackPanel>
                            <MenuItem Header="{Binding MenuItem1Text}"
                                      Command="{Binding AddItemCommand}"
                                      CommandParameter="{Binding MenuItem1Text}"
                                      Visibility="{Binding MenuItem1Visible,
                                                   Converter={StaticResource BoolToVisibility}}"/>
                            <MenuItem Header="{Binding MenuItem2Text}"
                                      Command="{Binding AddItemCommand}"
                                      CommandParameter="{Binding MenuItem2Text}"
                                      Visibility="{Binding MenuItem2Visible,
                                                   Converter={StaticResource BoolToVisibility}}"/>
                            <MenuItem Header="{Binding MenuItem3Text}"
                                      Command="{Binding AddItemCommand}"
                                      CommandParameter="{Binding MenuItem3Text}"
                                      Visibility="{Binding MenuItem3Visible,
                                                   Converter={StaticResource BoolToVisibility}}"/>
                            <MenuItem Header="{Binding MenuItem4Text}"
                                      Command="{Binding AddItemCommand}"
                                      CommandParameter="{Binding MenuItem4Text}"
                                      Visibility="{Binding MenuItem4Visible,
                                                   Converter={StaticResource BoolToVisibility}}"/>
                            <MenuItem Header="{Binding MenuItem5Text}"
                               Command="{Binding AddItemCommand}"
                               CommandParameter="{Binding MenuItem5Text}"
                               Visibility="{Binding MenuItem5Visible,
                               Converter={StaticResource BoolToVisibility}}"/>
                            
                               <MenuItem Header="{Binding MenuItem6Text}"
                               Command="{Binding AddItemCommand}"
                               CommandParameter="{Binding MenuItem6Text}"
                               Visibility="{Binding MenuItem6Visible,
                               Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <Button Content="Delete" Width="80" Margin="2"
                        Command="{Binding DeleteCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Разделитель -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

        <!-- Правая панель: редактор -->
        <Grid Grid.Column="2" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding SelectedTypeName}"
                       FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>

            <TextBox Grid.Row="1"
                     Text="{Binding SelectedText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     IsEnabled="{Binding HasSelection}"
                     TextChanged="TextBox_TextChanged"/>

            <Button Grid.Row="2" Content="Save" Width="100"
                    HorizontalAlignment="Right" Margin="0,8,0,0"
                    Command="{Binding SaveCommand}"/>
        </Grid>
    </Grid>
</Window>