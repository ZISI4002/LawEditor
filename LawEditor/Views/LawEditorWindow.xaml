<Window x:Class="LawEditor.Views.LawEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LawEditor.Models.ChangableData"
        xmlns:src="clr-namespace:LawEditor.Models.ChangableSourse"
        xmlns:root="clr-namespace:LawEditor.Models.RootClasses"
        Title="Law Editor"
        Height="800" Width="1300"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        Icon="/Assets/Writing_laws2.ico"
        Closing="Window_Closing">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" MinWidth="250"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#1E1E1E" CornerRadius="12" Padding="5">
                <ScrollViewer x:Name="TreeScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              PreviewMouseWheel="TouchpadScroll_PreviewMouseWheel">

                    <TreeView x:Name="treeView" ItemsSource="{Binding TreeRoots}"
                              SelectedItemChanged="TreeView_SelectedItemChanged">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type local:UpperObject}" ItemsSource="{Binding Headers}">
                                <TextBlock Text="{Binding ObjectName}" FontWeight="Bold" Foreground="#FF7700" Margin="0,2"/>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type local:Header}">
                                <TextBlock Text="{Binding FullText}" Foreground="#B2BEC3"/>
                            </DataTemplate>

                            <HierarchicalDataTemplate DataType="{x:Type local:Chapter}" ItemsSource="{Binding Sections}">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#FF9F43"/>
                            </HierarchicalDataTemplate>

                            <HierarchicalDataTemplate DataType="{x:Type local:Section}" ItemsSource="{Binding Articles}">
                                <TextBlock Text="{Binding Title}" Foreground="#FFEAA7" FontWeight="SemiBold"/>
                            </HierarchicalDataTemplate>

                            <HierarchicalDataTemplate DataType="{x:Type local:Article}" ItemsSource="{Binding Clauses}">
                                <TextBlock Text="{Binding Title}" Foreground="#DFE6E9"/>
                            </HierarchicalDataTemplate>

                            <HierarchicalDataTemplate DataType="{x:Type local:Clause}" ItemsSource="{Binding SubClauses}">
                                <TextBlock Text="{Binding Text}" Foreground="#BDC3C7" TextWrapping="NoWrap"/>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type local:SubClause}">
                                <TextBlock Text="{Binding Text}" Foreground="#95A5A6" Opacity="0.8"/>
                            </DataTemplate>

                            <HierarchicalDataTemplate DataType="{x:Type src:SourceData}" ItemsSource="{Binding Source}">
                                <TextBlock Text="{Binding Type}" FontWeight="Bold" Foreground="#D4AF37"/>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type src:TransitionalProvisions}">
                                <TextBlock Text="{Binding Title}" Foreground="#2E86AB" FontWeight="Bold"/>
                            </DataTemplate>

                            <HierarchicalDataTemplate DataType="{x:Type src:TransitionalProvisionsDateNote}" ItemsSource="{x:Null}">
                                <TextBlock Text="{Binding DisplayText}" Foreground="#5DADE2"/>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type src:SourceDocumentsList}">
                                <TextBlock Text="{Binding Title}" Foreground= "#C0392B" FontWeight="Bold"/>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type src:ConstitutionalAmendment}">
                                <TextBlock Text="{Binding Title}" Foreground="#27AE60" FontWeight="Bold"/>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Center">
                <Grid>
                    <ToggleButton x:Name="BtnAdd" Content="✚ Add" Width="100" Height="35" Margin="0,0,10,0"
                                  Style="{StaticResource ModernToggleButtonStyle}"
                                  IsChecked="{Binding IsAddMenuOpen, Mode=TwoWay}"/>

                    <Popup IsOpen="{Binding IsAddMenuOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=BtnAdd}"
                           Placement="Top" StaysOpen="False">
                        <Border Background="#2D2D2D" BorderBrush="#444444" BorderThickness="1" CornerRadius="8" Padding="5">
                            <StackPanel>
                                <MenuItem Header="{Binding MenuItem1Text}" Command="{Binding AddItemCommand}" CommandParameter="{Binding MenuItem1Text}" Foreground="White" Visibility="{Binding MenuItem1Visible, Converter={StaticResource BoolToVisibility}}"/>
                                <MenuItem Header="{Binding MenuItem2Text}" Command="{Binding AddItemCommand}" CommandParameter="{Binding MenuItem2Text}" Foreground="White" Visibility="{Binding MenuItem2Visible, Converter={StaticResource BoolToVisibility}}"/>
                                <MenuItem Header="{Binding MenuItem3Text}" Command="{Binding AddItemCommand}" CommandParameter="{Binding MenuItem3Text}" Foreground="White" Visibility="{Binding MenuItem3Visible, Converter={StaticResource BoolToVisibility}}"/>
                                <MenuItem Header="{Binding MenuItem4Text}" Command="{Binding AddItemCommand}" CommandParameter="{Binding MenuItem4Text}" Foreground="White" Visibility="{Binding MenuItem4Visible, Converter={StaticResource BoolToVisibility}}"/>
                                <MenuItem Header="{Binding MenuItem5Text}" Command="{Binding AddItemCommand}" CommandParameter="{Binding MenuItem5Text}" Foreground="White" Visibility="{Binding MenuItem5Visible, Converter={StaticResource BoolToVisibility}}"/>
                                <MenuItem Header="{Binding MenuItem6Text}" Command="{Binding AddItemCommand}" CommandParameter="{Binding MenuItem6Text}" Foreground="White" Visibility="{Binding MenuItem6Visible, Converter={StaticResource BoolToVisibility}}"/>
                                <MenuItem Header="{Binding MenuItem7Text}" Command="{Binding AddItemCommand}" CommandParameter="{Binding MenuItem7Text}" Foreground="White" Visibility="{Binding MenuItem7Visible, Converter={StaticResource BoolToVisibility}}"/>
                                <MenuItem Header="{Binding MenuItem8Text}" Command="{Binding AddItemCommand}" CommandParameter="{Binding MenuItem8Text}" Foreground="White" Visibility="{Binding MenuItem8Visible, Converter={StaticResource BoolToVisibility}}"/>

                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <Button Content="🗑 Delete" Width="100" Height="35"
                        Style="{StaticResource DeleteButtonStyle}"
                        Command="{Binding DeleteCommand}"/>
            </StackPanel>
        </Grid>

        <GridSplitter Grid.Column="1" Background="Transparent" Width="5" HorizontalAlignment="Stretch"/>

        <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="12" Padding="15" Margin="10,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="{Binding SelectedTypeName}"
                               Foreground="#3498DB" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>

                    <Button Content="?" Style="{StaticResource HelpQuestionButtonStyle}" HorizontalAlignment="Right">
                        <Button.ToolTip>
                            <ToolTip Placement="Left" HasDropShadow="True">
                                <StackPanel Margin="5" MinWidth="220">
                                    <TextBlock Text="Formatlaşdırma Qaydaları" 
                                               Foreground="#3498DB" 
                                               FontWeight="Bold" 
                                               FontSize="13" 
                                               Margin="0,0,0,8"/>

                                    <Rectangle Height="1" Fill="#444444" Margin="0,0,0,10"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Fəsil:" Foreground="#FF9F43" FontWeight="SemiBold" Margin="0,0,10,6"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text=" {1}" Foreground="#E0E0E0" FontFamily="Consolas" Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Maddə:" Foreground="#DFE6E9" FontWeight="SemiBold" Margin="0,0,10,6"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text=" [1]" Foreground="#E0E0E0" FontFamily="Consolas" Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Bənd:" Foreground="#BDC3C7" FontWeight="SemiBold" Margin="0,0,10,6"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text=" 1." Foreground="#E0E0E0" FontFamily="Consolas" Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Altbənd:" Foreground="#95A5A6" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text=" 1)" Foreground="#E0E0E0" FontFamily="Consolas" Margin="0,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="LineNumbersPanel"
                                Grid.Column="0" 
                                Background="#000000"
                                CornerRadius="8,0,0,8" 
                                IsHitTestVisible="False"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <ScrollViewer x:Name="LineNumbersScrollViewer"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="TouchpadScroll_PreviewMouseWheel">
                                <TextBox x:Name="LineNumbersBox"
                                         Background="Transparent"
                                         Foreground="#2B91AF"
                                         BorderThickness="0"
                                         FontSize="14"
                                         FontFamily="Consolas, Monaco, Courier New"
                                         Padding="8,5,5,5"
                                         TextAlignment="Right"
                                         IsReadOnly="True"
                                         IsTabStop="False"
                                         Focusable="False"/>
                            </ScrollViewer>
                        </Border>

                        <Rectangle Grid.Column="1" 
                                   Fill="#CCCCCC" 
                                   VerticalAlignment="Stretch"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"/>

                        <Border Grid.Column="2" Background="Transparent">
                            <RichTextBox x:Name="MainRichTextBox"
                 Background="Transparent"
                 Foreground="#1A1A1A"
                 CaretBrush="Black"
                 BorderThickness="0"
                 AcceptsReturn="True"
                 FontSize="14"
                 FontFamily="Consolas, Monaco, Courier New"
                 Padding="5"
                 IsEnabled="{Binding HasSelection}"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"
                 TextChanged="RichTextBox_TextChanged"/>
                        </Border>
                    </Grid>
                </Border>

                <Button Grid.Row="2" Content="✔ Save Changes" Width="140" Height="40"
                        Style="{StaticResource SaveButtonStyle}"
                        HorizontalAlignment="Right" Margin="0,15,0,0"
                        Command="{Binding SaveCommand}"/>
            </Grid>
        </Border>
    </Grid>
</Window>