<Window x:Class="LawEditor.Views.TableEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Table Editor"
        Height="560" Width="820"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="#121212"
        ResizeMode="CanResize"
    Icon="/Assets/TableIcon2.ico">
    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                Opacity="{TemplateBinding Opacity}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#333"/>
                                <Setter Property="Foreground" Value="#555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Footer buttons -->
        </Grid.RowDefinitions>

        <!-- Заголовок таблицы -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
            <TextBlock Text="Title:" Foreground="#A0A0A0" FontSize="13"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     Width="280" Height="30"
                     Background="#2D2D2D" Foreground="White"
                     CaretBrush="White" BorderBrush="#444"
                     FontSize="13" Padding="6,4"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Тулбар -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="+ Row"    Background="#27AE60" Style="{StaticResource ToolBtn}"
            Command="{Binding AddRowCommand}"
            CommandParameter="{Binding SelectedItem, ElementName=Grid}"
            Margin="0,0,6,0"/>
            <Button Content="− Row"    Background="#E67E22" Style="{StaticResource ToolBtn}"
            Command="{Binding DeleteRowCommand}"
            CommandParameter="{Binding SelectedItem, ElementName=Grid}"
            Margin="0,0,6,0"/>
            <Button Content="+ Column"   Background="#2980B9" Style="{StaticResource ToolBtn}"
            Command="{Binding AddColumnCommand}"
            CommandParameter="{Binding CurrentColumn, ElementName=Grid}"
            Margin="0,0,6,0"/>
            <Button Content="− Column"   Background="#8E44AD" Style="{StaticResource ToolBtn}"
            Command="{Binding DeleteColumnCommand}"
            CommandParameter="{Binding CurrentColumn, ElementName=Grid}"
            Margin="0,0,0,0"/>
        </StackPanel>
        
        <!-- DataGrid -->
        <Border Grid.Row="2" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <DataGrid x:Name="Grid"
              ItemsSource="{Binding Rows}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              Background="#121212" 
              Foreground="#E2E8F0" 
              RowBackground="#1A233D" 
              AlternatingRowBackground="#111827" 
              RowHeight="60"
              MinRowHeight="60"
              BorderThickness="0"
              GridLinesVisibility="All"
              HorizontalGridLinesBrush="#1E293B" 
              VerticalGridLinesBrush="#1E293B"
              
              ColumnWidth="SizeToCells" 
              
              HorizontalScrollBarVisibility="Auto" 
              
              FontSize="20" 
              FontFamily="Consolas"
              SelectionMode="Single"
              SelectionUnit="FullRow"
              Loaded="DataGrid_Loaded" >

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="Foreground" Value="#38BDF8"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="15,10,15,10"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="15,0,15,0"/>

                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                </DataGrid.Columns>

            </DataGrid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="✔ Save" Background="#27AE60"
        Style="{StaticResource ToolBtn}"
        Width="130" Height="36"
        Command="{Binding SaveTableCommand}"
        Margin="0,0,10,0"/>
            <Button Content="Cancel" Background="#555"
        Style="{StaticResource ToolBtn}"
        Width="100" Height="36"
        Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>