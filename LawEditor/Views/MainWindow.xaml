<Window x:Class="LawEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LawEditor.Views.Controls"
        Title="LawEditor"
        Height="800" Width="1550"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#121212"
        Icon="/Assets/Logo_of_the_National_Assembly_of_Azerbaijan.svg.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D2E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddWordButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#2B569A"/>
        </Style>
        <Style x:Key="CreateLawsButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#D4AF37"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style x:Key="GenerateButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="CrudButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Width" Value="110"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="{Binding FileNameLeft}" Foreground="#3498DB" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" HorizontalAlignment="Center" Visibility="{Binding IsDisplayLeftVisible, Converter={StaticResource BoolToVis}}"/>
        <TextBlock Grid.Column="4" Text="{Binding FileNameRight}" Foreground="#3498DB" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" HorizontalAlignment="Center" Visibility="{Binding IsDisplayRightVisible, Converter={StaticResource BoolToVis}}"/>

        <Border Grid.Row="1" Grid.Column="0" Background="#1E1E1E" CornerRadius="12" Padding="2">
            <Border Background="White" CornerRadius="10">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Visibility="{Binding IsDisplayButtonsVisible, Converter={StaticResource BoolToVis}}">
                        <Button Content="✜ Add Word" Style="{StaticResource AddWordButtonStyle}" Width="160" Margin="0,0,0,15" Command="{Binding AddWordCommand}"/>
                        <Button Content="⚖ Create Laws" Style="{StaticResource CreateLawsButtonStyle}" Width="160" Command="{Binding CreateLawsCommand}"/>
                    </StackPanel>
                    <RichTextBox x:Name="RichTextLeft" Background="Transparent" Foreground="#1A1A1A" BorderThickness="0" Padding="15" FontSize="15" Visibility="{Binding IsDisplayLeftVisible, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
        </Border>

        <Border Grid.Row="1" Grid.Column="4" Background="#1E1E1E" CornerRadius="12" Padding="2">
            <Border Background="White" CornerRadius="10">
                <RichTextBox x:Name="RichTextRight" Background="Transparent" Foreground="#1A1A1A" BorderThickness="0" Padding="15" FontSize="15" Visibility="{Binding IsDisplayRightVisible, Converter={StaticResource BoolToVis}}"/>
            </Border>
        </Border>

        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,20,0,0" Visibility="{Binding IsDisplayLeftVisible, Converter={StaticResource BoolToVis}}">
            <Button Content="Update" Style="{StaticResource CrudButtonStyle}" Background="#2D5FA6" Command="{Binding UpdateCommand}" Margin="0,0,10,0"/>
            <Button Content="Remove" Style="{StaticResource CrudButtonStyle}" Background="#C0392B" Command="{Binding RemoveCommand}"/>
        </StackPanel>

        <Button x:Name="BtnGenerate" Grid.Row="2" Grid.Column="2" Content="GENERATE" Style="{StaticResource GenerateButtonStyle}" Width="160" Height="45" Margin="0,20,0,0" Command="{Binding GenerateCommand}"/>

        <controls:LoadingOverlay Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="5" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Panel.ZIndex="1000"/>
    </Grid>
</Window>