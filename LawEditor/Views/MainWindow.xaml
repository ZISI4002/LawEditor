<Window x:Class="LawEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LawEditor" xmlns:viewmodels="clr-namespace:LawEditor.ViewModels" 
        mc:Ignorable="d"
        Title="LawEditor"
        Height="800" Width="1550"
        MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#1E1E1E"
        Icon="/Assets/Logo_of_the_National_Assembly_of_Azerbaijan.svg.ico">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="DisplayLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0000CD"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style x:Key="AddWordButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0000CD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                BorderThickness="3"
                                Padding="2">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00BFFF" Offset="0"/>
                                    <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#00BFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect Color="#00BFFF"
                                                  BlurRadius="10"
                                                  ShadowDepth="0"
                                                  Opacity="0.8"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1AFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00008B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GenerateButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#008000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#006400"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00A000"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#008000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#006400"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CrudButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="Auto" MinWidth="100"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
            <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>

        <!-- Левый заголовок -->
        <TextBlock x:Name="FileNameLabelLeft"
                   Grid.Row="0" Grid.Column="1"
                   Margin="0,8,0,0"
                   FontSize="18" FontWeight="Bold"
                   Foreground="#F0F0F0" Background="#4A4A4A"
                   TextAlignment="Center" Padding="8,4"
                   Text="{Binding FileNameLeft}"
                   Visibility="{Binding IsDisplayLeftVisible, Converter={StaticResource BoolToVis}}"/>

        <!-- Правый заголовок -->
        <TextBlock x:Name="FileNameLabelRight"
                   Grid.Row="0" Grid.Column="5"
                   Margin="0,8,0,0"
                   FontSize="18" FontWeight="Bold"
                   Foreground="#F0F0F0" Background="#4A4A4A"
                   TextAlignment="Center" Padding="8,4"
                   Text="{Binding FileNameRight}"
                   Visibility="{Binding IsDisplayRightVisible, Converter={StaticResource BoolToVis}}"/>

        <!-- Левая панель -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,10">
            <Border Background="#2D2D2D" BorderBrush="#3C3C3C"
                    BorderThickness="2" CornerRadius="10"/>

            <Button x:Name="BtnAddWord"
                    Content="Add Word" Width="130" Height="50"
                    Command="{Binding AddWordCommand}"
                    Visibility="{Binding IsAddWordVisible, Converter={StaticResource BoolToVis}}"
                    Style="{StaticResource AddWordButtonStyle}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Border x:Name="DisplayLeft"
                    Background="#E0FFFF" BorderBrush="#0000CD"
                    BorderThickness="2" CornerRadius="10"
                    Visibility="{Binding IsDisplayLeftVisible, Converter={StaticResource BoolToVis}}">
                <RichTextBox x:Name="RichTextLeft"
                             Background="Transparent"
                             BorderThickness="0"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             Padding="12"/>
            </Border>
        </Grid>

        <!-- Правая панель -->
        <Grid Grid.Row="1" Grid.Column="5" Margin="0,10,0,10">
            <Border Background="#2D2D2D" BorderBrush="#3C3C3C"
                    BorderThickness="2" CornerRadius="10"/>

            <Border x:Name="DisplayRight"
                    Background="#E0FFFF" BorderBrush="#0000CD"
                    BorderThickness="2" CornerRadius="10"
                    Visibility="{Binding IsDisplayRightVisible, Converter={StaticResource BoolToVis}}">
                <RichTextBox x:Name="RichTextRight"
                             Background="Transparent"
                             BorderThickness="0"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             Padding="12"/>
            </Border>
        </Grid>

        <!-- Кнопки под левой панелью по углам -->
        <Grid Grid.Row="2" Grid.Column="1"
              Margin="0,15,0,15"
              Visibility="{Binding IsDisplayLeftVisible, Converter={StaticResource BoolToVis}}">
            <Button x:Name="BtnUpdate" 
                    Content="✎ Update"
                    Background="#2D5FA6"
                    BorderBrush="#1A3F73"
                    Style="{StaticResource CrudButtonStyle}"
                    Command="{Binding UpdateCommand}"
                    HorizontalAlignment="Left"/>

            <Button x:Name="BtnRemove" 
                    Content="🗑 Remove"
                    Background="#6B2D6B"
                    BorderBrush="#4A1A4A"
                    Style="{StaticResource CrudButtonStyle}"
                    Command="{Binding RemoveCommand}"
                    HorizontalAlignment="Right"/>
        </Grid>

        <!-- Центральная кнопка Generate внизу -->
        <Button x:Name="BtnGenerate" 
                Grid.Row="2" Grid.Column="3"
                Width="130" Height="50"
                Margin="0,15,0,15"
                Content="Generate"
                Command="{Binding GenerateCommand}"
                Style="{StaticResource GenerateButtonStyle}"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>