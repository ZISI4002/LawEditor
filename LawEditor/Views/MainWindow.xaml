<Window x:Class="LawEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LawEditor.Views.Controls"
        mc:Ignorable="d"
        Title="LawEditor"
        Height="850" Width="1550"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#121212"
        Icon="/Assets/Logo_of_the_National_Assembly_of_Azerbaijan.svg.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="#3498DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Placement" Value="Mouse"/>
        </Style>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddWordButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#3498DB"/>
        </Style>

        <Style x:Key="CreateLawsButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#D4AF37"/>
            <Setter Property="Foreground" Value="#121212"/>
        </Style>

        <Style x:Key="GenerateButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="CrudButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="40"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" 
                   Text="{Binding FileNameLeft}" 
                   ToolTip="{Binding FileNameLeft}"
                   Foreground="#3498DB" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" 
                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Visibility="{Binding IsDisplayLeftVisible, Converter={StaticResource BoolToVis}}"/>

        <TextBlock Grid.Row="0" Grid.Column="4" 
                   Text="{Binding FileNameRight}" 
                   ToolTip="{Binding FileNameRight}"
                   Foreground="#3498DB" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" 
                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Visibility="{Binding IsDisplayRightVisible, Converter={StaticResource BoolToVis}}"/>

        <Border Grid.Row="1" Grid.Column="0" Background="#1E1E1E" CornerRadius="12" Padding="2">
            <Border Background="White" CornerRadius="10">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsDisplayButtonsVisible, Converter={StaticResource BoolToVis}}">
                        <Button Content="✜ Add Word document" Style="{StaticResource AddWordButtonStyle}" Width="200" Height="50" Margin="0,0,0,15" Command="{Binding AddWordCommand}"/>
                        <Button Content="⚖ Create Laws" Style="{StaticResource CreateLawsButtonStyle}" Width="200" Height="50" Command="{Binding CreateLawsCommand}"/>
                    </StackPanel>

                    <RichTextBox x:Name="RichTextLeft" 
                                 Background="Transparent" 
                                 Foreground="#1A1A1A" 
                                 BorderThickness="0" 
                                 Padding="15" 
                                 FontSize="15"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding IsDisplayLeftVisible, Converter={StaticResource BoolToVis}}"
                                 IsReadOnly="True" />
                </Grid>
            </Border>
        </Border>

        <Border Grid.Row="1" Grid.Column="4" Background="#1E1E1E" CornerRadius="12" Padding="2">
            <Border Background="White" CornerRadius="10">
                <RichTextBox x:Name="RichTextRight" 
                             Background="Transparent" 
                             Foreground="#1A1A1A" 
                             BorderThickness="0" 
                             Padding="15" 
                             FontSize="15"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding IsDisplayRightVisible, Converter={StaticResource BoolToVis}}"
                             IsReadOnly="True" />
            </Border>
        </Border>

        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,20,0,0" 
                    Visibility="{Binding IsDisplayLeftVisible, Converter={StaticResource BoolToVis}}">
            <Button Content="✎ Update" Style="{StaticResource CrudButtonStyle}" Background="#2D5FA6" Command="{Binding UpdateCommand}" Margin="0,0,12,0"/>
            <Button Content="🗑 Remove" Style="{StaticResource CrudButtonStyle}" Background="#C0392B" Command="{Binding RemoveCommand}"/>
        </StackPanel>

        <Button x:Name="BtnGenerate" Grid.Row="2" Grid.Column="2" 
                Content="GENERATE" Style="{StaticResource GenerateButtonStyle}" 
                Width="160" Height="50" Margin="0,20,0,0" 
                Command="{Binding GenerateCommand}"/>

        <controls:LoadingOverlay Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="5" 
                                 Panel.ZIndex="1000"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</Window>