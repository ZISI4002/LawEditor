<Window x:Class="LawEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LawEditor" xmlns:viewmodels="clr-namespace:LawEditor.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="LawEditor"
        Height="800" Width="1550"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#1E1E1E"
        Icon="/Assets/Logo_of_the_National_Assembly_of_Azerbaijan.svg.ico">

    <Window.Resources>

        <Style x:Key="DisplayLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0000CD"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style x:Key="AddWordButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0000CD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                BorderThickness="3"
                                Padding="2">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00BFFF" Offset="0"/>
                                    <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#00BFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect Color="#00BFFF"
                                                  BlurRadius="10"
                                                  ShadowDepth="0"
                                                  Opacity="0.8"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1AFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00008B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GenerateButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#008000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#006400"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00A000"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#008000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#006400"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CrudButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Canvas Background="#1E1E1E">

        <!-- TextBlock над левым дисплеем -->
        <TextBlock x:Name="FileNameLabelLeft"
           Canvas.Left="50" Canvas.Top="8"
           Width="600"
           FontSize="18"
           FontWeight="Bold"
           Foreground="#F0F0F0"
           Background="#4A4A4A"
           TextAlignment="Center"
           Padding="8,4"
           Text="{Binding FileNameLeft}"
           Visibility="Collapsed"/>
        <!-- TextBlock над правым дисплеем -->
        <TextBlock x:Name="FileNameLabelRight"
           Canvas.Left="900" Canvas.Top="8"
           Width="600"
           FontSize="18"
           FontWeight="Bold"
           Foreground="#F0F0F0"
           Background="#4A4A4A"
           TextAlignment="Center"
           Padding="8,4"
           Text="{Binding FileNameRight}"  
           Visibility="Collapsed"/>
        <!-- Левый квадрат с кнопкой Add Word -->
        <Border Canvas.Left="50" Canvas.Top="50"
                Width="600" Height="600"
                Background="#2D2D2D"
                BorderBrush="#3C3C3C"
                BorderThickness="2"
                CornerRadius="10">
            <Canvas>
                <Button x:Name="BtnAddWord"
                        Canvas.Left="235" Canvas.Top="270"
                        Width="130" Height="50"
                        Content="Add Word"
                        Command="{Binding AddWordCommand}"
                        Style="{StaticResource AddWordButtonStyle}"
                        Click="BtnAddWord_Click"/>
            </Canvas>
        </Border>

        <!-- Левый дисплей -->
        <Border x:Name="DisplayLeft"
                Canvas.Left="50" Canvas.Top="50"
                Width="600" Height="600"
                Background="#E0FFFF"
                BorderBrush="#0000CD"
                BorderThickness="2"
                CornerRadius="10"
                Visibility="Collapsed">
            <TextBlock x:Name="DisplayLabelLeft"
                       Style="{StaticResource DisplayLabelStyle}"
                       Text="Здесь будет текст"/>
        </Border>

        <!-- Кнопки Add / Update / Delete под левым дисплеем -->
        <Button x:Name="BtnAdd"
                Canvas.Left="50" Canvas.Top="665"
                Content="＋ Add"
                Background="#217346"
                BorderBrush="#145A32"
                Visibility="Collapsed"
                Style="{StaticResource CrudButtonStyle}"
                Command="{Binding AddCommand}"/>

        <Button x:Name="BtnUpdate"
                Canvas.Left="180" Canvas.Top="665"
                Content="✎ Update"
                Background="#2D5FA6"
                BorderBrush="#1A3F73"
                Visibility="Collapsed"
                Style="{StaticResource CrudButtonStyle}"
                Command="{Binding UpdateCommand}"/>

        <Button x:Name="BtnDelete"
                Canvas.Left="310" Canvas.Top="665"
                Content="✕ Delete"
                Background="#A62D2D"
                BorderBrush="#731A1A"
                Visibility="Collapsed"
                Style="{StaticResource CrudButtonStyle}"
                Command="{Binding DeleteCommand}"/>

        <!-- Правый квадрат (пустой) -->
        <Border Canvas.Left="900" Canvas.Top="50"
                Width="600" Height="600"
                Background="#2D2D2D"
                BorderBrush="#3C3C3C"
                BorderThickness="2"
                CornerRadius="10"/>

        <!-- Правый дисплей -->
        <Border x:Name="DisplayRight"
                Canvas.Left="900" Canvas.Top="50"
                Width="600" Height="600"
                Background="#E0FFFF"
                BorderBrush="#0000CD"
                BorderThickness="2"
                CornerRadius="10"
                Visibility="Collapsed">
            <TextBlock x:Name="DisplayLabelRight"
                       Style="{StaticResource DisplayLabelStyle}"
                       Text="Здесь будет текст"/>
        </Border>

        <!-- Кнопка Generate на своём месте -->
        <Button x:Name="BtnGenerate"
                Canvas.Left="710" Canvas.Top="680"
                Width="130" Height="50"
                Content="Generate"
                Style="{StaticResource GenerateButtonStyle}"
                Click="BtnGenerate_Click"/>

    </Canvas>
</Window>